# ==========================================================================
# ARCHIVO DE CONFIGURACIÓN DE ENTORNO — .env.example
# ==========================================================================
# Copia este archivo como ".env" antes de ejecutar ./instalar.sh:
#
#   cp .env.example .env
#
# A continuación edita el .env con los valores de tu entorno.
#
# LEYENDA:
#   [CAMBIAR]        -> Debes cambiar este valor antes de desplegar.
#   [AUTOGENERADO]   -> El script ./instalar.sh lo genera automáticamente.
#                      No es necesario que lo cambies manualmente.
#   [INTERNO DOCKER] -> URL usada solo entre contenedores. No modifiques
#                      el nombre de host (es el nombre del servicio Docker).
#   (opcional)       -> Solo necesario si activas esa funcionalidad.
# ==========================================================================


# --------------------------------------------------------------------------
# CONFIGURACIÓN GENERAL
# --------------------------------------------------------------------------

# Nombre de dominio o IP del servidor donde se desplegará el proyecto.
# - Desarrollo local:  localhost
# - Servidor remoto:   tu-dominio.com  o  192.168.1.100
# Este valor se usa como base para construir las URLs públicas de los servicios.
# [CAMBIAR si vas a desplegar en un servidor remoto]
DOMAIN=localhost


# --------------------------------------------------------------------------
# MOODLE — Plataforma LMS
# --------------------------------------------------------------------------

# Nombre del contenedor Docker de Moodle. Recomendable no cambiar.
MOODLE_NOMBRE_CONTENEDOR=moodle-matrix-dev-moodle-1

# Puerto en el que Moodle estará accesible desde el HOST (tu máquina o servidor).
MOODLE_PUERTO_HOST=8000
# Puerto interno del contenedor Moodle. NO CAMBIAR: la imagen oficial de Bitnami
# arranca Moodle siempre en el 8080 y no acepta otro valor aquí.
MOODLE_PUERTO_CONTENEDOR=8080

# [INTERNO DOCKER] URL usada por metrics-api para autenticar usuarios contra Moodle.
# El nombre de host "moodle" es el nombre del SERVICIO en docker-compose.yml (no el
# nombre del contenedor). Docker lo resuelve automáticamente como DNS interno.
# Si cambias el nombre del servicio "moodle:" en docker-compose.yml, debes actualizar
# también el nombre de host en esta URL y en MOODLE_SSO_AUTH_ENDPOINT.
MOODLE_AUTH_URL=http://moodle:${MOODLE_PUERTO_CONTENEDOR}/login/token.php

# [INTERNO DOCKER] Endpoint del plugin BdC en Moodle, usado por Synapse para el SSO.
# Mismo criterio que MOODLE_AUTH_URL: "moodle" es el nombre del servicio en docker-compose.
MOODLE_SSO_AUTH_ENDPOINT=http://moodle:${MOODLE_PUERTO_CONTENEDOR}/blocks/bdc/api/auth.php

# Nombre del sitio Moodle que aparecerá en la interfaz.
MOODLE_SITE_NAME="LLM Wiki Assistant Moodle"

# Credenciales del usuario administrador de Moodle que se creará al instalar.
# [CAMBIAR] Usa una contraseña segura en producción.
MOODLE_USERNAME=admin
MOODLE_PASSWORD=adminpass123
MOODLE_EMAIL=admin@example.com

# URL pública de Moodle tal como la verá el navegador del usuario.
# - Sin proxy inverso (desarrollo local): ${DOMAIN}:${MOODLE_PUERTO_HOST}  -> localhost:8000
# - Con proxy inverso (producción):       tu-dominio.com                   (sin puerto)
# [CAMBIAR si usas proxy inverso]
MOODLE_EXTERNAL_URL=${DOMAIN}:${MOODLE_PUERTO_HOST}

# Indica si Moodle está detrás de un proxy inverso (nginx, Traefik, etc.).
# Valores: 'yes' (con proxy) | 'no' (acceso directo por puerto)
# [CAMBIAR a 'yes' si usas proxy inverso]
MOODLE_REVERSEPROXY_ENABLED=no


# --------------------------------------------------------------------------
# BASES DE DATOS
# --------------------------------------------------------------------------

# --------------------------------------------------
# MARIADB — Base de datos de Moodle
# --------------------------------------------------

MARIADB_NOMBRE_CONTENEDOR=moodle-matrix-dev-mariadb-1
MARIADB_PUERTO_CONTENEDOR=3306

# Usuario de la base de datos de Moodle (usado por la aplicación, no el root).
MARIADB_USER=bn_moodle

# [CAMBIAR] Contraseña del usuario de la BD de Moodle.
MARIADB_PASSWORD=moodle_db_pass

# Nombre de la base de datos de Moodle.
MARIADB_DATABASE=bitnami_moodle

# [CAMBIAR] Contraseña del usuario root de MariaDB.
MARIADB_ROOT_PASSWORD=moodle_root_pass


# --------------------------------------------------
# POSTGRES — Base de datos de mapeo-api y metrics-api
# --------------------------------------------------

POSTGRES_NOMBRE_CONTENEDOR=moodle-matrix-dev-postgres-1

# Usuario y nombre de la base de datos principal (mapeo de alumnos y salas).
POSTGRES_USER=mapeo_user

# [CAMBIAR] Contraseña del usuario de Postgres.
POSTGRES_PASSWORD=mapeo_db_pass
POSTGRES_DB=mapeo_db

# Puerto interno de Postgres (estándar, no se expone al host directamente).
POSTGRES_PUERTO_CONTENEDOR=5432

# [INTERNO DOCKER] URL de conexión a Postgres usada por las APIs Python.
# No cambies el nombre de host "postgres"; es el nombre del servicio en docker-compose.
DATABASE_URL=postgresql+psycopg2://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:${POSTGRES_PUERTO_CONTENEDOR}/${POSTGRES_DB}


# --------------------------------------------------
# PGVECTOR — Base de datos vectorial para el bot LLM
# --------------------------------------------------

PGVECTOR_NOMBRE_CONTENEDOR=moodle-matrix-dev-pgvector-1

# Puerto expuesto al host (por si necesitas conectarte desde fuera con un cliente SQL).
PGVECTOR_PUERTO_HOST=5432
# Puerto interno del contenedor pgvector.
PGVECTOR_PUERTO_CONTENEDOR=5432

# Credenciales de la base de datos vectorial.
PGVECTOR_USER=llm_wiki

# [CAMBIAR] Contraseña del usuario de pgvector.
PGVECTOR_PASSWORD=llm_wiki_pass

# Nombre de la base de datos vectorial donde el bot almacena los embeddings
# (representaciones numéricas) de los documentos de los repositorios de alumnos.
# Se usa para la búsqueda semántica: cuando un alumno hace una pregunta, el bot
# busca aquí los fragmentos de texto más relevantes antes de responder con el LLM.
PGVECTOR_DB=vector_store


# --------------------------------------------------
# REDIS — Cola de tareas asíncronas (workers del bot)
# --------------------------------------------------

REDIS_NOMBRE_CONTENEDOR=moodle-matrix-dev-redis-1
REDIS_PUERTO_HOST=6379
REDIS_PUERTO_CONTENEDOR=6379


# --------------------------------------------------------------------------
# BACKUPS
# --------------------------------------------------------------------------

# Nombre del contenedor que ejecuta las copias de seguridad programadas.
BACKUP_NOMBRE_CONTENEDOR=moodle-matrix-dev-backup-1


# --------------------------------------------------------------------------
# MATRIX — Servidor de mensajería (Synapse) y cliente web (Element)
# --------------------------------------------------------------------------

# --------------------------------------------------
# SYNAPSE — Servidor Matrix
# --------------------------------------------------

SYNAPSE_NOMBRE_CONTENEDOR=moodle-matrix-dev-synapse-1

# Puerto en el que Synapse escucha. El puerto host es el accesible desde fuera.
SYNAPSE_PUERTO_HOST=8008
SYNAPSE_PUERTO_CONTENEDOR=8008

# [INTERNO DOCKER] URL usada por otros servicios (maubot, moodle) para hablar con Synapse.
SYNAPSE_URL=http://synapse:${SYNAPSE_PUERTO_CONTENEDOR}

# Usuario administrador de Synapse/Matrix creado durante la instalación.
SYNAPSE_ADMIN_USER=admin

# [CAMBIAR] Contraseña del administrador de Synapse.
SYNAPSE_ADMIN_PASSWORD=adminpass123_changeme

# Secretos criptográficos de Synapse.
# [AUTOGENERADO] El script ./instalar.sh los genera y rellena automáticamente.
SYNAPSE_REGISTRATION_SECRET=CHANGEME
SYNAPSE_MACAROON_SECRET=CHANGEME
SYNAPSE_FORM_SECRET=CHANGEME


# --------------------------------------------------
# ELEMENT — Cliente web de Matrix
# --------------------------------------------------

ELEMENT_NOMBRE_CONTENEDOR=moodle-matrix-dev-element-1

# Puerto donde Element estará disponible en el host.
ELEMENT_PUERTO_HOST=8081
# Puerto interno del contenedor (no cambiar, es el que usa la imagen oficial).
ELEMENT_PUERTO_CONTENEDOR=80

# URL base donde Element es accesible desde el navegador del usuario final.
# - Sin proxy inverso (desarrollo local): http://${DOMAIN}:${ELEMENT_PUERTO_HOST}
# - Con proxy inverso (producción):       https://${DOMAIN}/element (o el subdominio/ruta que configures en tu proxy)
# [CAMBIAR si usas proxy inverso]
ELEMENT_URL_BASE=http://${DOMAIN}:${ELEMENT_PUERTO_HOST}


# --------------------------------------------------------------------------
# BOTS (Maubot) Y MATRIX
# --------------------------------------------------------------------------

MAUBOT_NOMBRE_CONTENEDOR=moodle-matrix-dev-maubot-1

# Puerto del panel de administración de Maubot accesible desde el host.
MAUBOT_PUERTO_HOST=29317
# Puerto interno del contenedor donde Maubot escucha (no cambiar).
MAUBOT_PUERTO_CONTENEDOR=29316

# URL base de Maubot usada internamente (sin proxy inverso).
MAUBOT_URL_BASE=http://${DOMAIN}:${MAUBOT_PUERTO_HOST}

# URL pública del servidor Maubot (campo public_url en config.yaml).
# Esta URL es la que Maubot anuncia a los clientes externos.
# - Sin proxy inverso (local): http://localhost:29317
# - Con proxy inverso:         https://tu-dominio.com   (sin puerto)
# [CAMBIAR si usas proxy inverso]
MAUBOT_PUBLIC_URL=http://${DOMAIN}:${MAUBOT_PUERTO_HOST}

# [CAMBIAR] Contraseña del usuario administrador del panel web de Maubot.
MAUBOT_ADMIN_PASSWORD=maubotpass_changeme

# Token de acceso Matrix del usuario administrador. Lo usa el sistema para crear
# usuarios y salas en Matrix de forma automática (via API).
# [AUTOGENERADO] El script ./instalar.sh hace login en Synapse con las credenciales
MATRIX_ACCESS_TOKEN=changeme

# Identificador Matrix del bot que se invitará automáticamente a todas las salas.
# Formato: @nombre_usuario:dominio_del_servidor
# El dominio debe coincidir exactamente con DOMAIN.
MATRIX_BOT_USER=@llm_wiki_bot:${DOMAIN}

# Clave de cifrado para la base de datos de criptografía de Maubot.
# [AUTOGENERADO] El script ./instalar.sh la genera automáticamente.
MAUBOT_CRYPTO_PICKLE_KEY=GENERATE_RANDOM

# Nombres de los workers que procesan tareas asíncronas del bot (sync y log).
SYNC_WORKER_1_NOMBRE_CONTENEDOR=moodle-matrix-dev-sync-worker-1
SYNC_WORKER_2_NOMBRE_CONTENEDOR=moodle-matrix-dev-sync-worker-2


# --------------------------------------------------------------------------
# APIs INTERNAS (Mapeo API y Metrics API)
# --------------------------------------------------------------------------

# --------------------------------------------------
# MAPEO API — Gestión del mapeo alumno <-> sala Matrix
# --------------------------------------------------

MAPEO_API_NOMBRE_CONTENEDOR=moodle-matrix-dev-mapeo-api-1

# Puerto donde mapeo-api estará disponible desde el host.
MAPEO_API_PUERTO_HOST=8001
MAPEO_API_PUERTO_CONTENEDOR=8001

# Prefijo de ruta si mapeo-api está detrás de un proxy (ej: /api).
# Déjalo vacío si accedes directamente por puerto.
MAPEO_API_ROOT_PATH=

# Token de autenticación para las llamadas entre servicios internos a mapeo-api.
# [AUTOGENERADO] El script ./instalar.sh lo genera automáticamente.
MAPEO_API_TOKEN=changeme

# [INTERNO DOCKER] URL de mapeo-api usada por otros servicios (workers, moodle plugin).
MAPEO_API_URL=http://mapeo-api:${MAPEO_API_PUERTO_CONTENEDOR}


# --------------------------------------------------
# METRICS API — API de métricas de evaluación
# --------------------------------------------------

METRICS_API_NOMBRE_CONTENEDOR=metrics-api

# Puerto donde metrics-api escucha.
PORT_METRICS_API=8002

# [INTERNO DOCKER] URL de metrics-api usada por workers y otros servicios internos.
METRICS_API_URL=http://metrics-api:${PORT_METRICS_API}

METRICS_WORKER_NOMBRE_CONTENEDOR=metrics-worker

# Prefijo de ruta si metrics-api está detrás de un proxy (ej: /metrics).
# Déjalo vacío si accedes directamente por puerto.
METRICS_API_ROOT_PATH=


# --------------------------------------------------
# FRONTEND — Interfaz web de métricas
# --------------------------------------------------

FRONTEND_NOMBRE_CONTENEDOR=metrics-frontend

# Puerto donde el frontend estará accesible desde el host.
FRONTEND_PUERTO_HOST=3001
# Puerto interno del contenedor Node.js (no cambiar).
FRONTEND_PUERTO_CONTENEDOR=3000

# URL pública del frontend tal como la verá el navegador del usuario.
# - Sin proxy inverso (local): http://localhost:3001
# - Con proxy inverso:         https://tu-dominio.com  (sin puerto)
# [CAMBIAR si usas proxy inverso]
FRONTEND_URL=http://${DOMAIN}:${FRONTEND_PUERTO_HOST}

# [INTERNO DOCKER] URL que el servidor de desarrollo Vite usa para reenviar
# llamadas a la API.
VITE_API_TARGET_URL=http://metrics-api:${PORT_METRICS_API}

# Puerto externo para HMR si se usa un proxy inverso local (ej. 80 o 443).
# Déjalo comentado si accedes directamente por FRONTEND_PUERTO_HOST.
# VITE_HMR_PORT=80

# Subdominios permitidos por el dev server de Vite separados por coma
# VITE_ALLOWED_HOSTS=trazabilidad.midominio.com


# --------------------------------------------------
# DOXYGEN — Documentación generada automáticamente
# --------------------------------------------------

# Puerto donde se servirá la documentación Doxygen desde el host.
DOXYGEN_PUERTO_HOST=8005
DOXYGEN_NOMBRE_CONTENEDOR=doxygen-server


# --------------------------------------------------------------------------
# LLMs y PROVEEDORES DE IA
# --------------------------------------------------------------------------
# Solo necesitas configurar el proveedor que vayas a usar.
# Selecciona el proveedor activo en config/config.yaml (campo llm.proveedor_activo).


# --------------------------------------------------
# OLLAMA — LLM local (opcional)
# --------------------------------------------------
# Usa Ollama si quieres ejecutar modelos de lenguaje de forma local, sin coste
# de API y sin enviar datos a servicios externos.
# Ollama debe estar corriendo en tu máquina o servidor antes de iniciar el proyecto.
# Descarga: https://ollama.com

# [CAMBIAR] Puerto donde Ollama está escuchando en tu máquina (por defecto: 11434).
OLLAMA_PORT=puerto_Ollama_CHANGE_ME

LLM_SERVER_OPCIONAL_NOMBRE_CONTENEDOR=ollama-llm-service
LLM_SERVER_OPCIONAL_PUERTO_HOST=${OLLAMA_PORT}
LLM_SERVER_OPCIONAL_PUERTO_CONTENEDOR=${OLLAMA_PORT}

# URL que los contenedores Docker usan para acceder a Ollama en el host.
# "host.docker.internal" es la forma estándar de acceder al host desde Docker.
OLLAMA_BASE_URL=http://host.docker.internal:${OLLAMA_PORT}


# --------------------------------------------------
# OPENAI — API de OpenAI (opcional)
# --------------------------------------------------
# Usa OpenAI si quieres modelos como GPT-4o. Requiere cuenta y saldo en openai.com.

# [CAMBIAR] Tu clave de API de OpenAI (empieza por "sk-...").
OPENAI_API_KEY=sk-placeholder
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini


# --------------------------------------------------
# GEMINI — API de Google Gemini (opcional)
# --------------------------------------------------
# Usa Gemini si prefieres los modelos de Google. Requiere cuenta en Google AI Studio.

# [CAMBIAR] Tu clave de API de Gemini (empieza por "AIzaSy...").
GEMINI_API_KEY=AIzaSy_placeholder


# --------------------------------------------------------------------------
# GIT y TRAZABILIDAD (BdC — Biblioteca de Conocimiento)
# --------------------------------------------------------------------------
# El sistema puede crear y gestionar repositorios Git de alumnos automáticamente.
# Solo configura el proveedor que vayas a usar (selecciona en config/config.yaml).


# --------------------------------------------------
# GITHUB (proveedor por defecto)
# --------------------------------------------------

# [CAMBIAR] Token de acceso personal (PAT) de GitHub.
# Como crearlo: GitHub -> Settings -> Developer settings -> Personal access tokens
# Permisos necesarios: "repo" (acceso completo a repositorios).
GITHUB_PAT=changeme

# [CAMBIAR] Nombre de tu usuario u organización de GitHub donde se crearán los repositorios.
GITHUB_ORG=changeme


# --------------------------------------------------
# GITLAB (alternativa)
# --------------------------------------------------

# [CAMBIAR] Token de acceso de GitLab con permisos de API.
# Solo necesario si usas GitLab como proveedor (llm.proveedor_activo = gitlab).
GITLAB_TOKEN=changeme

# [CAMBIAR] Nombre del grupo de GitLab donde se crearán los repositorios.
GITLAB_GROUP=changeme


# --------------------------------------------------
# GIT AUTOALOJADO — Gitea, Forgejo, GitLab CE (alternativa)
# --------------------------------------------------

# [CAMBIAR] Token de acceso del servicio autoalojado.
# Solo necesario si usas un servidor Git propio (llm.proveedor_activo = self_hosted).
GIT_SELF_HOSTED_TOKEN=changeme

# [CAMBIAR] Nombre de la organización en tu servidor Git autoalojado.
SELF_HOSTED_ORG=changeme

# [CAMBIAR] URL base de la API de tu servidor Git autoalojado.
# Ejemplo Gitea: https://gitea.midominio.com/api/v1
SELF_HOSTED_API_URL=changeme


# --------------------------------------------------
# REPOSITORIO PLANTILLA
# --------------------------------------------------

# Nombre del repositorio que se usará como plantilla para crear los repos de alumnos.
# Debe existir en la organización/grupo configurado arriba.
TEMPLATE_ID=BdC-template


# --------------------------------------------------------------------------
# COMPORTAMIENTO DEL ENTORNO
# --------------------------------------------------------------------------

# Activa el agente de evaluación automática (módulo BdC-trazabilidad).
ENABLE_EVALUATION_AGENT=true

# Entorno de ejecución: 'dev' (desarrollo) | 'prod' (producción).
# En 'dev' se habilitan funciones de depuración adicionales.
ENVIRONMENT=dev

# Activa el modo de autenticación de demostración (sin Moodle real).
# Útil para probar la interfaz sin tener Moodle configurado.
# [CAMBIAR a false en producción]
ENABLE_DEMO_AUTH=true

# Simula las llamadas a servicios externos (Git, LLM) con respuestas ficticias.
# Útil para desarrollo offline. Desactívalo en producción.
MOCK_SERVICES=false


# --------------------------------------------------------------------------
# SECRETOS INTERNOS DE SEGURIDAD
# --------------------------------------------------------------------------
# Estas claves se usan para firmar tokens JWT, cifrar datos sensibles y
# autenticar comunicaciones entre servicios internos.
# [AUTOGENERADO] El script ./instalar.sh genera valores aleatorios seguros
# y los escribe en tu .env automáticamente. No es necesario cambiarlos manualmente.

AGENT_HMAC_SECRET=GENERATE_RANDOM
INTERNAL_SERVICE_TOKEN=GENERATE_RANDOM
PII_SECRET_KEY=GENERATE_RANDOM
JWT_SECRET_KEY=GENERATE_RANDOM
