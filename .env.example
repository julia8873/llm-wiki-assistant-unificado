DOMAIN=localhost

OLLAMA_PORT=puerto_Ollama_CHANGE_ME

MARIADB_USER=bn_moodle
MARIADB_PASSWORD=moodle_db_pass
MARIADB_DATABASE=bitnami_moodle
MARIADB_ROOT_PASSWORD=moodle_root_pass
MARIADB_NOMBRE_CONTENEDOR=moodle-matrix-dev-mariadb-1

MOODLE_NOMBRE_CONTENEDOR=moodle-matrix-dev-moodle-1
MOODLE_PUERTO_HOST=8000
MOODLE_PUERTO_CONTENEDOR=8080

POSTGRES_USER=mapeo_user
POSTGRES_PASSWORD=mapeo_db_pass
POSTGRES_DB=mapeo_db
DATABASE_URL=postgresql+psycopg2://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

MOODLE_USERNAME=admin
MOODLE_PASSWORD=adminpass123
MOODLE_EMAIL=admin@example.com

SYNAPSE_NOMBRE_CONTENEDOR=moodle-matrix-dev-synapse-1
SYNAPSE_PUERTO_HOST=8008
SYNAPSE_PUERTO_CONTENEDOR=8008
SYNAPSE_ADMIN_USER=admin
SYNAPSE_ADMIN_PASSWORD=adminpass123_changeme

ELEMENT_NOMBRE_CONTENEDOR=moodle-matrix-dev-element-1
ELEMENT_PUERTO_HOST=8081
ELEMENT_PUERTO_CONTENEDOR=80

MAUBOT_NOMBRE_CONTENEDOR=moodle-matrix-dev-maubot-1
MAUBOT_PUERTO_HOST=29317
MAUBOT_PUERTO_CONTENEDOR=29316
MAUBOT_ADMIN_PASSWORD=maubotpass_changeme

MAPEO_API_NOMBRE_CONTENEDOR=moodle-matrix-dev-mapeo-api-1
MAPEO_API_PUERTO_HOST=8001
MAPEO_API_PUERTO_CONTENEDOR=8000

LLM_SERVER_OPCIONAL_NOMBRE_CONTENEDOR=ollama-llm-service
LLM_SERVER_OPCIONAL_PUERTO_HOST=${OLLAMA_PORT}
LLM_SERVER_OPCIONAL_PUERTO_CONTENEDOR=${OLLAMA_PORT}
OLLAMA_BASE_URL=http://host.docker.internal:${OLLAMA_PORT}

# Token de acceso personal de GitHub. (necesita permiso "repo")
GITHUB_PAT=changeme

# Token de acceso de GitLab (si proveedor_activo = gitlab en config.yaml)
GITLAB_TOKEN=changeme

# Token de acceso de Gitea/GitLab CE (si proveedor_activo = self_hosted)
GIT_SELF_HOSTED_TOKEN=changeme
OPENAI_API_KEY=sk-placeholder
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=AIzaSy_placeholder

# Se autogenerará automáticamente al ejecutar ./instalar.sh
MAPEO_API_TOKEN=changeme

# Token de acceso para administrador (creación de usuarios y salas en Matrix)
MATRIX_ACCESS_TOKEN=changeme

# Usuario del Bot que se invitará automáticamente a todas las salas (Maubot)
MATRIX_BOT_USER=@llm_wiki_bot:localhost



# Se autogenerará automáticamente al ejecutar ./instalar.sh
MAUBOT_CRYPTO_PICKLE_KEY=GENERATE_RANDOM

# --- Variables de bdc-trazabilidad ---
ENABLE_EVALUATION_AGENT=true
# Se autogenerarán automáticamente al ejecutar ./instalar.sh
AGENT_HMAC_SECRET=GENERATE_RANDOM
INTERNAL_SERVICE_TOKEN=GENERATE_RANDOM

# Se autogenerará automáticamente al ejecutar ./instalar.sh
PII_SECRET_KEY=GENERATE_RANDOM

# ID del repositorio de plantilla
TEMPLATE_ID=BdC-template
