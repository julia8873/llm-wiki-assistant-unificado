# ==============================================================================
# PLANTILLA config.yaml — Plugin llm-wiki-assistant en Maubot
# Copia a moodle-matrix-dev/maubot/config.yaml y rellena los secretos.
# ==============================================================================
homeserver:
  url: "http://matrix-synapse:8008"
  server_name: "${DOMAIN}"

bot_user:
  mxid: "@llm_wiki_bot:${DOMAIN}"
  access_token: "${BOT_ACCESS_TOKEN}"

plugin_config:
  github_pat: "${GITHUB_PAT}"
  github_org: "${GITHUB_ORG}"
  default_branch: "${GITHUB_DEFAULT_BRANCH}"

  # Proveedor LLM activo: "openai" | "gemini" | "ollama"
  llm_provider: "${LLM_PROVIDER}"

  openai_api_key: "${OPENAI_API_KEY}"
  openai_base_url: "https://api.openai.com/v1"
  openai_model: "${OPENAI_MODEL}"

  gemini_api_key: "${GEMINI_API_KEY}"
  gemini_base_url: "https://generativelanguage.googleapis.com/v1beta"
  gemini_model: "${GEMINI_MODEL}"

  ollama_base_url: "${OLLAMA_BASE_URL}"
  ollama_model: "${OLLAMA_MODEL}"

  moodle_api_url: "http://moodle-matrix-dev-moodle-1:8000"
  moodle_wstoken: "${MOODLE_WSTOKEN}"
