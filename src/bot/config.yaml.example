# URI completa de la base de datos. SQLite y Postgres están totalmente soportados.
# Ejemplos de formato:
#   SQLite:   sqlite:filename.db
#   Postgres: postgresql://usuario:contraseña@hostname/nombre_bd
database: sqlite:/data/maubot.db
crypto_db_pickle_key: "${MAUBOT_CRYPTO_PICKLE_KEY}"

# URL de base de datos separada para la base de datos de cifrado. "default" significa usar la misma que arriba.
crypto_database: default

# Argumentos adicionales para asyncpg.create_pool() o sqlite3.connect()
# https://magicstack.github.io/asyncpg/current/api/index.html#asyncpg.pool.create_pool
# https://docs.python.org/3/library/sqlite3.html#sqlite3.connect
# Para sqlite, min_size se usa como tamaño del pool de hilos de conexión y max_size se ignora.
database_opts:
    min_size: 1
    max_size: 10

plugin_directories:
    # Directorio donde se almacenarán los plugins nuevos subidos.
    upload: /data/plugins
    # Directorios desde los que se cargarán los plugins.
    # Los plugins con IDs duplicados se moverán a la papelera.
    load:
    - /data/llm-wiki-assistant-plugin
    trash: /data/trash

# Configuración para el almacenamiento de bases de datos de plugins
plugin_databases:
    # Directorio donde se almacenarán las bases de datos SQLite de los plugins.
    sqlite: /data/dbs
    # URL de conexión para las bases de datos de plugins. Si es null, todos los plugins usarán SQLite.
    # Si se define, los plugins que usen la nueva interfaz asyncpg obtendrán una conexión Postgres.
    # Los plugins que usen la interfaz legacy SQLAlchemy siempre usarán SQLite.
    #
    # Para usar el mismo pool de conexiones que la base de datos principal, establece "default"
    # (la base de datos principal de arriba debe ser postgres para esto).
    #
    # Cuando está habilitado, maubot creará esquemas Postgres separados en la BD por cada plugin.
    # Para ver los esquemas en psql, usa `\dn`. Para entrar e interactuar con un esquema concreto,
    # usa `SET search_path = nombre` (donde `nombre` es el encontrado con `\dn`) y luego
    # ejecuta consultas SQL o comandos psql normales.
    postgres:
    # Número máximo de conexiones por instancia de plugin.
    postgres_max_conns_per_plugin: 3
    # Sobrescrituras de database_opts por defecto al usar una cadena de conexión postgres distinta de "default".
    postgres_opts: {}

server:
    # IP y puerto donde escucha el servidor.
    hostname: 0.0.0.0
    port: 29316
    # URL base pública donde el servidor es visible para los clientes.
    # Si usas una subruta aquí, el proxy inverso debe eliminar el prefijo.
    # Establece este valor según cómo accedan los clientes:
    #   - Sin proxy inverso (local): http://localhost:29317
    #   - Con proxy inverso:         https://nombredelhost.com
    # Configura MAUBOT_PUBLIC_URL en el archivo .env según corresponda.
    public_url: "${MAUBOT_PUBLIC_URL}"
    # Ruta base para la interfaz de administración. No cambia la ruta de la API.
    # Añade un prefijo de ruta a public_url si quieres que todo esté en una subruta.
    ui_base_path: /_matrix/maubot
    # Ruta base para los endpoints de plugins. El ID de instancia se añadirá directamente.
    plugin_base_path: /_matrix/maubot/plugin/
    # Ruta alternativa desde donde cargar los recursos de la interfaz de administración.
    # Establece a false para usar pkg_resources para encontrar la ruta.
    override_resource_path: /opt/maubot/frontend
    # Secreto compartido para firmar los tokens de acceso a la API.
    # Establece a "generate" para generar y guardar un nuevo token al arrancar.
    unshared_secret: "generate"

# Servidores Matrix conocidos. Necesario para el comando `mbc auth` y para un acceso
# más cómodo desde la interfaz de administración. No es obligatorio para crear clientes
# en la interfaz, ya que también puedes escribir la URL del homeserver directamente.
homeservers:
    matrix.org:
    # URL de la API cliente-servidor
        url: https://matrix-client.matrix.org
    # registration_shared_secret del config de Synapse

    # Puedes dejarlo vacío si no tienes acceso al homeserver.

    # Si está vacío, `mbc auth --register` no funcionará, pero `mbc auth` (login) sí.
        secret:

admins:
    admin: "${MAUBOT_ADMIN_PASSWORD}"

api_features:
    login: true
    plugin: true
    plugin_upload: true
    instance: true
    instance_database: true
    client: true
    client_proxy: true
    client_auth: true
    dev_open: true
    log: true

# Configuración de logs de Python.
#
# Consulta la sección 16.7.2 de la documentación de Python para más información:
# https://docs.python.org/3.6/library/logging.config.html#configuration-dictionary-schema
logging:
    version: 1
    formatters:
        colored:
            (): maubot.lib.color_log.ColorFormatter
            format: '[%(asctime)s] [%(levelname)s@%(name)s] %(message)s'
        normal:
            format: '[%(asctime)s] [%(levelname)s@%(name)s] %(message)s'
    handlers:
        file:
            class: logging.handlers.RotatingFileHandler
            formatter: normal
            filename: /var/log/maubot.log
            maxBytes: 10485760
            backupCount: 10
        console:
            class: logging.StreamHandler
            formatter: colored
    loggers:
        maubot:
            level: DEBUG
        mau:
            level: DEBUG
        aiohttp:
            level: INFO
    root:
        level: DEBUG
        handlers: [file, console]
